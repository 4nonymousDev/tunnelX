{
  "name": "tunnelx-desktop",
  "version": "0.2.4",
  "private": true,
  "description": "TunnelX desktop frontend",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "verify:preload": "node scripts/verify-preload.mjs",
    "verify:release-notes": "node scripts/verify-release-notes.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && npm run verify:preload",
    "package": "npm run build && electron-builder",
    "package:signed": "npm run build && electron-builder --config electron-builder.signed.cjs",
    "test:security": "npm run build:electron && node --test scripts/security.test.cjs scripts/update-policy.test.cjs scripts/update-manager.test.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "build": {
    "appId": "com.tunnelx.desktop",
    "productName": "TunnelX",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../tunnelx-cli.exe",
        "to": "core/tunnelx-cli.exe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/verify-package.cjs",
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "4nonymousDev",
        "repo": "tunnelX",
        "releaseType": "release"
      }
    ]
  }
}
